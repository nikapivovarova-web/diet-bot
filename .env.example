# Runtime
# Use development for local experiments. In production the bot refuses to start
# without DIET_BOT_SUPPORT_CHAT_ID and DIET_BOT_PRIVACY_POLICY_URL.
DIET_BOT_ENV=development
# Keep server, container, database, and human-facing timestamps explicit.
TZ=UTC

# Telegram bot
# Required: set exactly one bot token variable. DIET_BOT_TOKEN is preferred.
DIET_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Payments
# Required only when YooKassa/card payments via Telegram are enabled.
TELEGRAM_PROVIDER_TOKEN=

# Database
# Required for Docker Compose and production. Docker Compose also uses
# POSTGRES_* for the bundled PostgreSQL service; keep DIET_BOT_DATABASE_URL
# pointed at the same database. Replace YOUR_POSTGRES_PASSWORD before startup;
# healthcheck rejects example placeholders.
POSTGRES_DB=diet_bot
POSTGRES_USER=diet_bot
POSTGRES_PASSWORD=
DIET_BOT_DATABASE_URL=postgresql://diet_bot:YOUR_POSTGRES_PASSWORD@postgres:5432/diet_bot
# Required before approving a PostgreSQL production release; point at staging/test DB only.
# DIET_BOT_TEST_DATABASE_URL=postgresql://diet_bot:password@localhost:5432/diet_bot_test

# Support/admin
# Required in production. Telegram chat id where user support requests will be
# sent. For private supergroups usually starts with -100.
DIET_BOT_SUPPORT_CHAT_ID=
# Required in production. Public HTTPS URL to the privacy policy.
DIET_BOT_PRIVACY_POLICY_URL=
DIET_BOT_ADMIN_USER_IDS=
# Alias accepted by the bot for the same admin list.
DIET_BOT_ADMIN_IDS=
DIET_BOT_TESTER_CHAT_IDS=

# Analytics
# Optional. Set DIET_BOT_ANALYTICS_ENABLED=1 to archive product events in
# PostgreSQL and, when POSTHOG_API_KEY is set, send them to PostHog.
DIET_BOT_ANALYTICS_ENABLED=0
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
# Stable salt for pseudonymous PostHog distinct_id values and sanitized log IDs.
# Use a production secret; changing it rotates analytics identities.
DIET_BOT_ANALYTICS_ID_SALT=

# Optional behavior
DIET_BOT_DROP_PENDING_UPDATES=0
DIET_BOT_GENERATION_CLEANUP_INTERVAL_SECONDS=300
DIET_BOT_POLLING_HEARTBEAT_FILE=/tmp/diet_bot_polling_heartbeat.json
DIET_BOT_POLLING_HEARTBEAT_INTERVAL_SECONDS=15
DIET_BOT_POLLING_HEARTBEAT_MAX_AGE_SECONDS=90
DIET_BOT_ALLOW_LEGACY_PAYLOADS_UNTIL=
# Hidden test-access command name, without the leading slash. Leave empty to disable it.
DIET_BOT_TEST_ACCESS_COMMAND=
# Local development only. Leave 0 in production.
DIET_BOT_ALLOW_JSON_STORAGE=0

# Optional local JSON state path overrides. Leave commented unless you need them.
# DIET_BOT_STATE_FILE=.diet_bot_state/history.json
# DIET_BOT_SUBSCRIPTIONS_STATE_FILE=.diet_bot_state/subscriptions.json
# DIET_BOT_PROMO_CODES_STATE_FILE=.diet_bot_state/promo_codes.json
# DIET_BOT_PAYMENT_ORDERS_STATE_FILE=.diet_bot_state/payment_orders.json
