# FoodBalance production environment template.
# Copy these keys into the deployment secret manager and fill real values there.
# Never commit real bot tokens, provider tokens, database DSNs, chat IDs, or spool paths.

# Telegram
DIET_BOT_ENV=production
DIET_BOT_TOKEN=
# Optional legacy fallback only if DIET_BOT_TOKEN is not set.
TELEGRAM_BOT_TOKEN=

# Storage/Postgres
DIET_BOT_STORAGE_BACKEND=postgres
# Production must not allow JSON storage. Current runtime enforces this through
# DIET_BOT_STORAGE_BACKEND and production validation; keep this template guard at 0.
DIET_BOT_ALLOW_JSON_STORAGE=0
DIET_BOT_DATABASE_URL=
DIET_BOT_POSTGRES_POOL_ENABLED=0
DIET_BOT_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
DIET_BOT_POSTGRES_POOL_MIN_SIZE=1
DIET_BOT_POSTGRES_POOL_MAX_SIZE=4
DIET_BOT_POSTGRES_POOL_TIMEOUT_SECONDS=5.0

# Workers/Queues
# Production Postgres queues require both durable workers to be enabled.
DIET_BOT_ONE_DAY_WORKER_ENABLED=1
DIET_BOT_ONE_DAY_WORKER_CONCURRENCY=1
DIET_BOT_ONE_DAY_WORKER_LEASE_SECONDS=300
DIET_BOT_ONE_DAY_WORKER_HEARTBEAT_SECONDS=60
DIET_BOT_ONE_DAY_WORKER_RETRY_DELAY_SECONDS=30
DIET_BOT_ONE_DAY_WORKER_MAX_ATTEMPTS=3
DIET_BOT_ONE_DAY_WORKER_IDLE_SLEEP_SECONDS=1.0
DIET_BOT_WEEKLY_PDF_WORKER_ENABLED=1
DIET_BOT_WEEKLY_PDF_WORKER_CONCURRENCY=1
DIET_BOT_WEEKLY_PDF_WORKER_LEASE_SECONDS=300
DIET_BOT_WEEKLY_PDF_WORKER_HEARTBEAT_SECONDS=60
DIET_BOT_WEEKLY_PDF_WORKER_RETRY_DELAY_SECONDS=30
DIET_BOT_WEEKLY_PDF_WORKER_MAX_ATTEMPTS=3
DIET_BOT_WEEKLY_PDF_WORKER_IDLE_SLEEP_SECONDS=1.0
# Optional bounded DB executor settings for synchronous Postgres work.
DIET_BOT_DB_EXECUTOR_MAX_WORKERS=4
DIET_BOT_DB_EXECUTOR_MAX_QUEUE_SIZE=16
DIET_BOT_DB_EXECUTOR_QUEUE_TIMEOUT_SECONDS=2.0

# Payments
# Keep payments disabled unless payment QA or live enablement is explicitly approved.
DIET_BOT_PAYMENTS_ENABLED=0
DIET_BOT_PUBLIC_PAYMENTS_ENABLED=0
DIET_BOT_PAYMENT_TEST_PRICES_ENABLED=0
# YooKassa/card invoices use TELEGRAM_PROVIDER_TOKEN when payments are enabled.
# Telegram Stars invoices do not use a separate provider-token env var in current runtime.
TELEGRAM_PROVIDER_TOKEN=
# Required when DIET_BOT_PAYMENTS_ENABLED=1. Use a durable absolute path outside
# the repository, temp directories, and container scratch storage.
DIET_BOT_PAYMENT_RECOVERY_SPOOL=

# Promo/Admin
DIET_BOT_ADMIN_USER_IDS=
# Production promo activation/admin actions require the Postgres promo store
# whenever DIET_BOT_STORAGE_BACKEND=postgres.
# JSON promo state is only an import seed/local fallback, not production truth.

# Privacy/Support
DIET_BOT_SUPPORT_CHAT_ID=
DIET_BOT_PRIVACY_POLICY_URL=

# Monitoring/Ops
DIET_BOT_HEALTHCHECK_STRICT=1
DIET_BOT_WEEKLY_SELECTION_DIAG=0
# Backup and restore drill DSNs belong in operator secret storage.
DIET_BOT_BACKUP_DATABASE_URL=
DIET_BOT_RESTORE_ADMIN_DATABASE_URL=
# Optional explicit PostgreSQL client tool paths for ops scripts.
DIET_BOT_PG_DUMP_PATH=
DIET_BOT_PG_RESTORE_PATH=
DIET_BOT_CREATEDB_PATH=
DIET_BOT_DROPDB_PATH=

# Local/dev only
# Do not use JSON state files as production source of truth.
DIET_BOT_STATE_FILE=
DIET_BOT_SUBSCRIPTIONS_STATE_FILE=
DIET_BOT_PROMO_CODES_STATE_FILE=
DIET_BOT_TEST_DATABASE_URL=
DIET_BOT_TESTER_CHAT_IDS=
DIET_BOT_RUN_LOCAL_LIVE_QA=0
DIET_BOT_CONTROLLED_QA_BOT_TOKEN_MARKER=
DIET_BOT_CONTROLLED_QA_DATABASE_MARKER=
