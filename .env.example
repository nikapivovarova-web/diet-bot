# Local-only example. Copy to .env for your shell or dotenv tool.
# .env and .env.* are ignored by git; never commit real tokens or secrets.

PYTHONPATH=src
DIET_BOT_ENV=development

# Required for Telegram polling. Prefer DIET_BOT_TOKEN.
DIET_BOT_TOKEN=replace-with-telegram-bot-token

# Legacy fallback alias; leave empty unless you intentionally use it.
TELEGRAM_BOT_TOKEN=

# Optional Telegram/YooKassa card payment provider token for local smoke.
TELEGRAM_PROVIDER_TOKEN=

# Optional operations/tester controls.
DIET_BOT_SUPPORT_CHAT_ID=
DIET_BOT_ADMIN_USER_IDS=
DIET_BOT_TESTER_CHAT_IDS=

# Local JSON state files used by the clean runtime.
DIET_BOT_STATE_FILE=.diet_bot_state/history.json
DIET_BOT_SUBSCRIPTIONS_STATE_FILE=.diet_bot_state/subscriptions.json
DIET_BOT_PROMO_CODES_STATE_FILE=.diet_bot_state/promo_codes.json
