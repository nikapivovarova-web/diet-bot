# Market-launch example. Copy to .env for your shell or dotenv tool.
# .env and .env.* are ignored by git; never commit real tokens or secrets.

PYTHONPATH=src
DIET_BOT_ENV=production

# Required for Telegram polling. Prefer DIET_BOT_TOKEN.
DIET_BOT_TOKEN=replace-with-telegram-bot-token

# Legacy fallback alias; leave empty unless you intentionally use it.
TELEGRAM_BOT_TOKEN=

# Required for market-launch YooKassa/card invoices through Telegram Payments.
TELEGRAM_PROVIDER_TOKEN=replace-with-live-yookassa-telegram-provider-token

# Market launch: public YooKassa/Stars payment buttons are visible.
DIET_BOT_PUBLIC_PAYMENTS_ENABLED=1

# Keep disabled for production. Public launch must not use smoke/test prices.
# Stars monthly is a true auto-renewing Telegram Stars subscription.
# YooKassa/card monthly is a one-time 30-day access purchase.
# One-day extra and weekly PDF extra are one-time purchases.
# Current production prices: 799 RUB / 450 Stars monthly,
# 69 RUB / 40 Stars one-day extra, 349 RUB / 199 Stars weekly PDF extra.
# Approved provider smoke prices are separate: Stars monthly 1 Star and still recurring;
# YooKassa monthly 100 RUB / 10_000 minor units.
DIET_BOT_PAYMENT_TEST_PRICES_ENABLED=0

# Optional operations/tester controls.
DIET_BOT_SUPPORT_CHAT_ID=
DIET_BOT_ADMIN_USER_IDS=replace-with-owner-telegram-user-id
# Keep empty for launch/payment smoke; tester chat grants can mask paywall checks.
# Use admin user ids, not tester chat grants, for owner smoke prices.
DIET_BOT_TESTER_CHAT_IDS=

# First-party launch attribution uses Telegram deep links:
# https://t.me/FoodbalanceRu_bot?start=<source>_<campaign>
# Example campaign payload: ig_ad_001. First touch is stored in Postgres only.

# Storage: choose one path.
# Market launch requires PostgreSQL. JSON storage is local/dev only.
DIET_BOT_ALLOW_JSON_STORAGE=0
DIET_BOT_DATABASE_URL=postgresql://replace-with-production-postgres-url
DIET_BOT_DB_POOL_MAX_SIZE=20

# Local JSON state files are used only when explicitly opting into local JSON development.
DIET_BOT_STATE_FILE=.diet_bot_state/history.json
DIET_BOT_SUBSCRIPTIONS_STATE_FILE=.diet_bot_state/subscriptions.json
DIET_BOT_PROMO_CODES_STATE_FILE=.diet_bot_state/promo_codes.json
